// ERP Prisma schema — sanitary & bathroom fittings wholesale business
// Database: Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================================
// ENUMS
// ==========================================================

enum Role {
  ADMIN
  STAFF
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

// Two parallel receivable accounts kept per customer, mirroring the
// business's existing paper ledger (Default A/c = Cash, Bill A/C = Bill).
enum LedgerAccountType {
  CASH
  BILL
}

enum LedgerEntryType {
  OPENING
  SALE
  RETURN
  PAYMENT
  ADJUSTMENT
}

// ==========================================================
// AUTH
// ==========================================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@map("users")
}

// ==========================================================
// CUSTOMER
// ==========================================================

model Customer {
  id                 String   @id @default(cuid())
  companyName        String
  contactPerson      String?
  mobile             String
  address            String?
  gstNumber          String?
  openingCashBalance Decimal  @default(0) @db.Decimal(14, 2)
  openingBillBalance Decimal  @default(0) @db.Decimal(14, 2)
  notes              String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sales         Sale[]
  returns       Return[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]

  @@index([companyName])
  @@index([mobile])
  @@map("customers")
}

// ==========================================================
// PRODUCT
// ==========================================================

model Product {
  id            String        @id @default(cuid())
  itemName      String
  brand         String?
  category      String?
  specification String?
  unit          String        @default("PCS")
  purchasePrice Decimal       @default(0) @db.Decimal(12, 2)
  sellingPrice  Decimal       @db.Decimal(12, 2)
  gstPercent    Decimal       @default(0) @db.Decimal(5, 2)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  saleItems   SaleItem[]
  returnItems ReturnItem[]

  @@index([itemName])
  @@index([category])
  @@index([brand])
  @@map("products")
}

// ==========================================================
// INVOICE / DOCUMENT NUMBER COUNTERS
// ==========================================================

model InvoiceCounter {
  id            String  @id @default(cuid())
  key           String // "SALE" | "RETURN" | "PAYMENT"
  financialYear String // e.g. "2025-26"
  prefix        String
  currentNumber Int     @default(0)

  updatedAt DateTime @updatedAt

  @@unique([key, financialYear])
  @@map("invoice_counters")
}

// ==========================================================
// SALES
// ==========================================================

model Sale {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  invoiceDate   DateTime
  customerId    String
  subtotal      Decimal  @db.Decimal(14, 2)
  discountTotal Decimal  @default(0) @db.Decimal(14, 2)
  gstTotal      Decimal  @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal  @db.Decimal(14, 2)
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer      @relation(fields: [customerId], references: [id])
  createdBy     User?         @relation(fields: [createdById], references: [id])
  items         SaleItem[]
  returns       Return[]
  ledgerEntries LedgerEntry[]

  @@index([customerId])
  @@index([invoiceDate])
  @@map("sales")
}

model SaleItem {
  id              String  @id @default(cuid())
  saleId          String
  productId       String
  itemName        String
  quantity        Decimal @db.Decimal(12, 2)
  rate            Decimal @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @db.Decimal(12, 2)
  gstPercent      Decimal @default(0) @db.Decimal(5, 2)
  gstAmount       Decimal @default(0) @db.Decimal(12, 2)
  total           Decimal @db.Decimal(14, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ==========================================================
// RETURNS
// ==========================================================

model Return {
  id           String   @id @default(cuid())
  returnNumber String   @unique
  returnDate   DateTime
  customerId   String
  saleId       String?
  reason       String?
  subtotal     Decimal  @db.Decimal(14, 2)
  gstTotal     Decimal  @default(0) @db.Decimal(14, 2)
  grandTotal   Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer      Customer      @relation(fields: [customerId], references: [id])
  sale          Sale?         @relation(fields: [saleId], references: [id])
  items         ReturnItem[]
  ledgerEntries LedgerEntry[]

  @@index([customerId])
  @@index([returnDate])
  @@map("returns")
}

model ReturnItem {
  id         String  @id @default(cuid())
  returnId   String
  productId  String
  itemName   String
  quantity   Decimal @db.Decimal(12, 2)
  rate       Decimal @db.Decimal(12, 2)
  gstPercent Decimal @default(0) @db.Decimal(5, 2)
  gstAmount  Decimal @default(0) @db.Decimal(12, 2)
  total      Decimal @db.Decimal(14, 2)

  return  Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@map("return_items")
}

// ==========================================================
// PAYMENTS
// ==========================================================

model Payment {
  id            String            @id @default(cuid())
  paymentNumber String            @unique
  customerId    String
  date          DateTime
  amount        Decimal           @db.Decimal(14, 2)
  mode          PaymentMode
  accountType   LedgerAccountType
  remarks       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  customer      Customer      @relation(fields: [customerId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([customerId])
  @@index([date])
  @@map("payments")
}

// ==========================================================
// LEDGER — single source of truth for customer balances
// ==========================================================

model LedgerEntry {
  id         String  @id @default(cuid())
  customerId String
  // Monotonic tiebreaker guaranteeing stable chronological ordering
  // (independent of same-millisecond createdAt collisions) so running
  // balances always replay in the exact order they were posted.
  sequence   Int     @default(autoincrement())

  entryDate       DateTime
  type            LedgerEntryType
  accountType     LedgerAccountType
  description     String
  referenceNumber String?

  saleId    String?
  returnId  String?
  paymentId String?

  debit  Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)

  // Running balances snapshotted at insert time (both accounts, on every
  // row) so the ledger view/PDF never needs to replay the full history.
  cashBalanceAfter Decimal @db.Decimal(14, 2)
  billBalanceAfter Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  sale     Sale?    @relation(fields: [saleId], references: [id])
  return   Return?  @relation(fields: [returnId], references: [id])
  payment  Payment? @relation(fields: [paymentId], references: [id])

  @@index([customerId, entryDate])
  @@index([customerId, sequence])
  @@map("ledger_entries")
}

// ==========================================================
// SETTINGS (single row)
// ==========================================================

model Settings {
  id            String   @id @default(cuid())
  businessName  String   @default("My Business")
  address       String?
  gstNumber     String?
  phone         String?
  email         String?
  logoUrl       String?
  invoicePrefix String   @default("INV")
  returnPrefix  String   @default("RET")
  paymentPrefix String   @default("PAY")
  invoiceFooter String?
  theme         String   @default("light")
  updatedAt     DateTime @updatedAt

  @@map("settings")
}
